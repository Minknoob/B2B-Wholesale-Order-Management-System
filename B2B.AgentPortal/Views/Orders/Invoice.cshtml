@model OrderDetailVm
@{
    ViewData["Title"] = $"Hóa đơn #{Model.OrderId}";
    Layout = null;   // trang in riêng, không navbar
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - B2B Wholesale</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="invoice-body">
    <div class="invoice-toolbar no-print">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@Model.OrderId">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
        <button type="button" class="btn btn-b2b-primary btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>In hóa đơn
        </button>
    </div>

    <article class="invoice-sheet">
        <header class="d-flex justify-content-between flex-wrap gap-3 pb-3 mb-4 border-bottom">
            <div>
                <div class="text-uppercase small text-secondary fw-semibold mb-1">B2B Wholesale Order Management</div>
                <h1 class="h4 mb-1 tabular-nums">Hóa đơn #@Model.OrderId</h1>
                <div class="text-muted small">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="text-muted small">Trạng thái: @Model.OrderStatus</div>
            </div>
            <div class="text-md-end">
                <div class="small text-secondary">Đơn vị nhận hàng (Đại lý)</div>
                <div class="fw-semibold fs-6">@Model.AgentName</div>
                @if (!string.IsNullOrWhiteSpace(Model.AgentAddress))
                {
                    <div class="small text-secondary">@Model.AgentAddress</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.AgentPhone))
                {
                    <div class="small text-secondary">ĐT: @Model.AgentPhone</div>
                }
            </div>
        </header>

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 48px;">#</th>
                        <th>Mặt hàng</th>
                        <th>Kích cỡ</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        var l = Model.Lines[i];
                        <tr>
                            <td class="text-secondary tabular-nums">@(i + 1)</td>
                            <td class="fw-medium">@l.ItemName</td>
                            <td class="text-secondary">@l.Size</td>
                            <td class="text-end tabular-nums">@l.Quantity.ToString("N0")</td>
                            <td class="text-end tabular-nums">@l.UnitAmount.ToString("N0") ₫</td>
                            <td class="text-end tabular-nums">@l.LineTotal.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end pt-3">Tổng tiền thanh toán</th>
                        <th class="text-end pt-3 fs-5 tabular-nums">@Model.Total.ToString("N0") ₫</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <footer class="mt-4 pt-3 border-top d-flex justify-content-between small text-secondary">
            <span>Chứng từ được xuất từ hệ thống B2B Agent Portal</span>
            <span>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </footer>
    </article>
</body>
</html>
