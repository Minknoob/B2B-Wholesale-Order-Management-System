@using System.Security.Claims
@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isAgentAuthenticated = User.TryGetAgentId(out int currentAgentId);
    string? agentName = User.FindFirstValue(AgentPortalClaims.AgentNameClaimType);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - B2B Wholesale</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark portal-navbar py-2">
            <div class="container">
                <a class="navbar-brand" asp-controller="Catalog" asp-action="Index">
                    <i class="bi bi-box-seam me-1"></i>
                    <span>B2B Wholesale</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (isAgentAuthenticated)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                            <li class="nav-item">
                                <a class="nav-link @(string.Equals(currentController, "Catalog", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Catalog" asp-action="Index">
                                    <i class="bi bi-grid me-1"></i>Catalog
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(string.Equals(currentController, "Orders", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Create", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Orders" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i>Tạo đơn mới
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(string.Equals(currentController, "Orders", StringComparison.OrdinalIgnoreCase) && !string.Equals(currentAction, "Create", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-receipt me-1"></i>My Orders
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mt-2 mt-lg-0">
                            <span class="agent-identity-pill tabular-nums">
                                <i class="bi bi-person-circle me-1"></i>@(string.IsNullOrWhiteSpace(agentName) ? User.Identity?.Name : $"{agentName} ({User.Identity?.Name})") · ĐL #@currentAgentId
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-light btn-sm px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 my-1">
        @RenderBody()
    </main>

    <footer class="portal-footer py-3">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-1">
            <span>B2B Wholesale Order Management System — Agent Portal</span>
            <span>ASP.NET Core MVC · EF Core + SQL Server</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
